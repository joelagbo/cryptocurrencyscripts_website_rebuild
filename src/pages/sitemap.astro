---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { getPosts, getCategories, getTags, formatDate, decodeEntities, postsByCategory } from "../lib/content";
import { breadcrumbJsonLd } from "../lib/seo";

const posts = getPosts();
const categories = getCategories();
const tags = getTags().filter((t) => t.count >= 2);
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Sitemap", href: "/sitemap/" },
];
---

<Layout
  title="Sitemap - CryptocurrencyScripts"
  description="Complete list of CryptocurrencyScripts pages, blog posts, and categories for readers and search engines."
  jsonLd={[breadcrumbJsonLd(crumbs)]}
>
  <div class="wrap html-sitemap">
    <Breadcrumbs items={crumbs} />
    <h1 class="page-title">Sitemap</h1>
    <p>All public pages and {posts.length} articles on CryptocurrencyScripts.</p>

    <h2>Main pages</h2>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/about-us/">About Us</a></li>
      <li><a href="/blog/">Blog</a></li>
      <li><a href="/contact-us/">Contact Us</a></li>
      <li><a href="/rss.xml">RSS feed</a></li>
    </ul>

    <h2>Categories</h2>
    <ul>
      {categories.map((cat) => (
        <li>
          <a href={`/category/${cat.slug}/`}>{cat.name}</a> ({postsByCategory(cat.slug).length})
        </li>
      ))}
    </ul>

    <h2>Blog posts</h2>
    {categories.map((cat) => {
      const group = postsByCategory(cat.slug);
      return (
        <section>
          <h3><a href={`/category/${cat.slug}/`}>{cat.name}</a></h3>
          <ul>
            {group.map((post) => (
              <li>
                <a href={`/${post.slug}/`}>{decodeEntities(post.title)}</a>
                <time datetime={post.date}> — {formatDate(post.date)}</time>
              </li>
            ))}
          </ul>
        </section>
      );
    })}

    {tags.length > 0 && (
      <section>
        <h2>Topics</h2>
        <ul class="tag-cloud">
          {tags.map((tag) => (
            <li><a href={`/tag/${tag.slug}/`}>{tag.name}</a></li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Layout>
