---
import "../../styles/global.css";
import "../../styles/admin.css";
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Blog CMS - CryptocurrencyScripts</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://cryptocurrencyscripts.com/cms/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
  </head>
  <body class="cms">
    <header class="cms-top">
      <h1>CryptocurrencyScripts CMS</h1>
      <div class="cms-actions">
        <a href="/">View site</a>
        <button class="cms-btn secondary" id="logout" type="button">Log out</button>
      </div>
    </header>

    <div class="cms-body">
      <p id="cms-status" class="cms-status cms-hidden"></p>

      <section id="view-login" class="cms-card">
        <h2>Sign in with GitHub</h2>
        <p class="cms-help">
          Create a fine-grained personal access token with <strong>Contents: Read and write</strong> on
          <code>cryptocurrencyscripts_website_rebuild</code>. The token stays in this browser tab only.
        </p>
        <form id="login-form">
          <div class="cms-field">
            <label for="token">GitHub token</label>
            <input id="token" name="token" type="password" autocomplete="off" required />
          </div>
          <div class="cms-field">
            <label for="owner">Owner</label>
            <input id="owner" name="owner" type="text" />
          </div>
          <div class="cms-field">
            <label for="repo">Repository</label>
            <input id="repo" name="repo" type="text" />
          </div>
          <div class="cms-field">
            <label for="branch">Branch</label>
            <input id="branch" name="branch" type="text" />
          </div>
          <button class="cms-btn" type="submit">Load posts</button>
        </form>
      </section>

      <section id="view-list" class="cms-hidden">
        <div class="cms-row">
          <div>
            <h2 style="margin:0">Blog posts</h2>
            <p class="cms-help" id="post-count"></p>
          </div>
          <button class="cms-btn" id="new-post" type="button">New post</button>
        </div>
        <input class="cms-search" id="search" type="search" placeholder="Search posts" />
        <div class="cms-card" style="padding:0;overflow:auto;margin-top:16px">
          <table class="cms-table">
            <thead>
              <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Date</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="post-rows"></tbody>
          </table>
        </div>
      </section>

      <section id="view-editor" class="cms-card cms-hidden">
        <div class="cms-row">
          <h2 id="editor-title" style="margin:0">Edit post</h2>
          <div class="cms-actions">
            <button class="cms-btn secondary" id="cancel-edit" type="button">Back</button>
            <button class="cms-btn" id="save-post" type="button">Save to GitHub</button>
          </div>
        </div>
        <div class="cms-field">
          <label for="title">Title</label>
          <input id="title" type="text" />
        </div>
        <div class="cms-field">
          <label for="slug">Slug (URL)</label>
          <input id="slug" type="text" />
        </div>
        <div class="cms-field">
          <label for="date">Publish date</label>
          <input id="date" type="datetime-local" />
        </div>
        <div class="cms-field">
          <span>Categories</span>
          <div class="cms-cats" id="categories"></div>
        </div>
        <div class="cms-field">
          <label for="featuredImage">Featured image URL</label>
          <input id="featuredImage" type="text" placeholder="/uploads/2026/10/photo.jpg" />
          <input id="featured-file" type="file" accept="image/*" style="margin-top:8px" />
        </div>
        <div class="cms-field">
          <label for="excerpt">Excerpt</label>
          <textarea id="excerpt" rows="3"></textarea>
        </div>
        <div class="cms-field">
          <label for="seoTitle">SEO title</label>
          <input id="seoTitle" type="text" />
        </div>
        <div class="cms-field">
          <label for="seoDescription">SEO description</label>
          <textarea id="seoDescription" rows="2"></textarea>
        </div>
        <div class="cms-field">
          <label>Body</label>
          <div id="editor"></div>
          <input id="inline-image" type="file" accept="image/*" hidden />
        </div>
      </section>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js" is:inline></script>
    <script src="/cms.js" is:inline></script>
  </body>
</html>
