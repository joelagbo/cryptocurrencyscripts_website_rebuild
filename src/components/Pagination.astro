---
interface Props {
  current: number;
  totalPages: number;
  base: string;
}

const { current, totalPages, base } = Astro.props;
const root = base.endsWith("/") ? base : `${base}/`;

function href(page: number) {
  return page <= 1 ? root : `${root}${page}/`;
}

const pages: (number | "…")[] = [];
if (totalPages <= 7) {
  for (let i = 1; i <= totalPages; i++) pages.push(i);
} else {
  pages.push(1);
  if (current > 3) pages.push("…");
  for (let i = Math.max(2, current - 1); i <= Math.min(totalPages - 1, current + 1); i++) pages.push(i);
  if (current < totalPages - 2) pages.push("…");
  pages.push(totalPages);
}
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="Pagination">
    {pages.map((p) =>
      p === "…" ? (
        <span>…</span>
      ) : p === current ? (
        <span class="current">{p}</span>
      ) : (
        <a href={href(p)}>{p}</a>
      )
    )}
    {current > 1 && <a class="page-text" href={href(current - 1)} rel="prev">Previous</a>}
    {current < totalPages && <a class="page-text" href={href(current + 1)} rel="next">Next Page</a>}
  </nav>
)}
